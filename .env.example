# --- Person A: reverse image search provider ---
SEARCH_API_PROVIDER=serpapi        # or bing_visual_search, pimeyes
SEARCH_API_KEY=#

# --- Person B: blockchain ---
BLOCKCHAIN_NETWORK=polygon_amoy    # or hardhat_local
# rpc-amoy.polygon.technology does not currently resolve (confirmed) — use a working
# public Amoy RPC such as https://polygon-amoy-bor-rpc.publicnode.com, or your own
# Alchemy/Infura endpoint.
RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
PRIVATE_KEY=#
# Unused by any code here — the deployed contract address is read from
# blockchain/deployments/<network>.json instead, written by scripts/deploy.js.

# --- Shared ---
LOG_LEVEL=INFO
